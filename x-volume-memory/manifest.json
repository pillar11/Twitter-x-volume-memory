{
  "manifest_version": 3,
  "name": "X Video Volume Memory",
  "version": "1.0",
  "description": "Remembers the volume you set on X (Twitter) videos and uses it for every video.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "X Video Volume Memory"
  }
}
